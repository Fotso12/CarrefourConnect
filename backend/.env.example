# ============================================================
# CarrefourConnect - Variables d'environnement du backend (MODÈLE)
# Copiez ce fichier en ".env" (ignoré par Git) et remplissez les vraies valeurs :
#   Copy-Item .env.example .env        (PowerShell)
# Ne commitez JAMAIS le fichier .env.
# ============================================================

# === Base de données PostgreSQL / PostGIS ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carrefourconnect
SPRING_DATASOURCE_USERNAME=carrefourconnect
SPRING_DATASOURCE_PASSWORD=changez-moi

# === JWT ===
# Au moins 64 caractères (HS512). Pour en générer une en PowerShell :
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=changez-moi-avec-une-cle-aleatoire-d-au-moins-64-caracteres
# JWT_EXPIRATION_MS=86400000

# === Email (Mailjet SMTP) ===
MAILJET_SMTP_HOST=smtp.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_API_KEY=votre-cle-api-mailjet
MAILJET_API_SECRET=votre-secret-mailjet
MAILJET_FROM_EMAIL=no-reply@example.com
ADMIN_EMAIL=admin@example.com

# === Cloudinary (images) ===
CLOUDINARY_CLOUD_NAME=votre-cloud
CLOUDINARY_API_KEY=votre-cle-cloudinary
CLOUDINARY_API_SECRET=votre-secret-cloudinary

# === Divers ===
APP_BASE_URL=http://localhost:8084
# PORT=8084
