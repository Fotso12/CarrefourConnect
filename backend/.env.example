# ===========================================================
# CarrefourConnect - Variables d'environnement (TEMPLATE)
# Copiez ce fichier en ".env" et remplissez les valeurs réelles
# $ cp .env.example .env
# ===========================================================

# === Base de données PostgreSQL ===
DB_USERNAME=votre_utilisateur_postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# === Email (Gmail SMTP) ===
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre_app_password_gmail_16_chars
ADMIN_EMAIL=votre.email@gmail.com

# === JWT Secret ===
JWT_SECRET=une_cle_secrete_longue_et_aleatoire
