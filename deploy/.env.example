# ============================================================
# Variables pour deploy/docker-compose.yml (MODÈLE, sans aucun vrai secret)
#
#   Copy-Item deploy\.env.example deploy\.env      (PowerShell, depuis la racine du dépôt)
#
# deploy/.env est ignoré par Git : c'est LUI qui contient tes vraies valeurs.
# Docker Compose le lit automatiquement (il est à côté de docker-compose.yml).
# ============================================================

# === Base PostgreSQL / PostGIS (conteneur "db") ===
POSTGRES_DB=carrefourconnect
POSTGRES_USER=carrefourconnect
# Mot de passe local, au choix (n'utilise pas un mot de passe réel)
POSTGRES_PASSWORD=changez-moi

# === JWT ===
# OBLIGATOIRE, au moins 64 caractères (signature HS512). Pour en générer une :
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=changez-moi-avec-une-cle-aleatoire-d-au-moins-64-caracteres-0123456789

# === Email (Mailjet) : facultatif en local ===
# Avec des valeurs factices, l'application démarre ; seul l'envoi d'emails échouera.
MAILJET_API_KEY=factice
MAILJET_API_SECRET=factice
MAILJET_FROM_EMAIL=no-reply@example.com
ADMIN_EMAIL=admin@example.com

# === Cloudinary : facultatif en local ===
CLOUDINARY_CLOUD_NAME=factice
CLOUDINARY_API_KEY=factice
CLOUDINARY_API_SECRET=factice
